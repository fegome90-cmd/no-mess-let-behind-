{
  "name": "no-mess-left-behind",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Obsidian control surface for existing vault governance tools.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node esbuild.config.mjs production",
    "test": "tsc && node --import ./tests/register-obsidian.mjs --test tests/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:headless": "node --test tests/headless/*.test.mjs",
    "verify:headless": "pnpm verify && pnpm test:headless",
    "doctor": "node tools/doctor.mjs",
    "package:plugin": "node tools/package.mjs",
    "install:plugin": "node tools/install.mjs",
    "inspect:staged": "node tools/staged.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "esbuild": "0.25.5",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "wdio-obsidian-service": "3.5.0",
    "webdriverio": "10.1.0"
  }
}
