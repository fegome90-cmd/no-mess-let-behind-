{
  "name": "no-mess-left-behind",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Obsidian control surface for existing vault governance tools.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node esbuild.config.mjs production",
    "test": "tsc && node --import ./tests/register-obsidian.mjs --test tests/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "esbuild": "0.25.5",
    "obsidian": "1.8.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
